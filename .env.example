# First Mate config. Copy this file to .env only if you want an optional upgrade.
# No keys and no credits are needed. The demo runs complete with this
# file left blank: Local only summary on this machine, and direct fetch
# for links. Nothing below is required, and nothing is waited on.
# Keys are optional upgrades only. Add one only if you already have it
# and want that route used instead of the free mode.
# To check what an install will actually use, run: python3 -m first_mate config

# Context.dev - optional upgrade, gives the agent the web with one API.
# Without a key, links are read by direct fetch instead, and the
# All accesses panel says so plainly.
CONTEXT_DEV_API_KEY=
CONTEXT_DEV_BASE_URL=https://api.context.dev

# NY Token Exchange / TrustedRouter - optional upgrade, private inference.
# Without a key, base URL, and model, the summary is made locally on
# this machine and no team data leaves it. First Mate does not guess
# an endpoint for this route.
NYTE_API_KEY=
NYTE_BASE_URL=
NYTE_MODEL=
# TrustedRouter can be used instead, same shape:
TRUSTEDROUTER_API_KEY=
TRUSTEDROUTER_BASE_URL=
TRUSTEDROUTER_MODEL=

# App settings
FIRST_MATE_DATA_DIR=data/ship-logs
FIRST_MATE_HOST=0.0.0.0
FIRST_MATE_PORT=8000
FIRST_MATE_FETCH_TIMEOUT=8
# Set to 1 only when this copy is actually running on a Boat.dev VM,
# so the All accesses panel can say so.
FIRST_MATE_ON_BOAT=
